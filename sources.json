  {
    "name": "Гостинформ",
    "base_url": "https://www.gostinfo.ru",
    "start_url": "https://www.gostinfo.ru/News/List",
    "include_patterns": [
      "/News/"
    ],
    "include_regex": "/News/Details/[^/?#]+/?$",
    "link_min_text_len": 8,
    "enabled": true,
    "request_strategy": {
      "connect_timeout": 5,
      "read_timeout": 25,
