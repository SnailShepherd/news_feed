      "retry_statuses": [
        401,
        403,
        404,
        429,
        500,
        502,
        503,
        504
      ],
      "extra_headers": {
        "Accept-Language": "ru-RU,ru;q=0.9,en;q=0.8",
        "Referer": "https://minfin.gov.ru/"
      },
      "warmup": {
        "url": "https://minfin.gov.ru/ru/press-center/",
        "delay": [
          2,
          4
        ],
        "timeout": 40
      },
      "selenium_fallback": true,
      "selenium_wait": 5,
      "selenium_wait_for": [
        "a[href*=\"/20\"]"
      ],
      "selenium_scroll_steps": 4,
      "capture_cookies": true,
      "record_path_on_success": true
    }
  },
